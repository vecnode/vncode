{
  "id": "developer-card",
  "title": "Developer card",
  "intent": "A README header for a tool: phosphor ground, monospaced display, one luminous accent and a faint scanline grid.",
  "preset": "og",
  "archetype": "code-card",
  "style": "terminal",
  "copy": {
    "eyebrow": "TOOL",
    "headline": "your-tool --help",
    "subhead": "What it does, in one line.",
    "cta": "npm i your-tool"
  },
  "document": {
    "title": "Developer card",
    "preset": "og",
    "canvas": {
      "width": 1200,
      "height": 630,
      "background": {
        "type": "solid",
        "color": "#0b0f0b"
      }
    },
    "tokens": {
      "color": {
        "ink": "#c9ffd6",
        "muted": "#7fb68c",
        "accent": "#39ff88",
        "surface": "#0b0f0b",
        "panel": "#101710",
        "accent-ink": "#06120a",
        "line": "#1e2b1e",
        "warm": "#ffb000"
      },
      "font": {
        "display": "system",
        "text": "Inter",
        "mono": "system"
      },
      "scale": {
        "display": 44,
        "title": 40,
        "subtitle": 26,
        "body": 22,
        "caption": 14
      },
      "space": 8,
      "radius": {
        "card": 0,
        "pill": 2,
        "chip": 0
      }
    },
    "layers": [
      {
        "kind": "shape",
        "id": "backdrop",
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 640,
        "shape": "rect",
        "fill": {
          "type": "solid",
          "color": "#0b0f0b"
        }
      },
      {
        "kind": "text",
        "id": "headline",
        "x": 64,
        "y": 152,
        "w": 552,
        "text": "Ship a plugin today.",
        "style": "display",
        "weight": 700,
        "family": "mono",
        "color": "#c9ffd6",
        "lineHeight": 1.3,
        "letterSpacing": 0
      },
      {
        "kind": "text",
        "id": "subhead",
        "x": 64,
        "y": 264,
        "w": 552,
        "text": "One row, one bundle.",
        "style": "body",
        "family": "text",
        "color": "#7fb68c"
      },
      {
        "kind": "frame",
        "id": "cta",
        "x": 64,
        "y": 340,
        "w": "hug",
        "h": 44,
        "background": {
          "type": "solid",
          "color": "#c9ffd6"
        },
        "radius": 2,
        "direction": "row",
        "padding": {
          "top": 13,
          "right": 22,
          "bottom": 13,
          "left": 22
        },
        "justify": "center",
        "align": "center",
        "children": [
          {
            "kind": "text",
            "id": "cta-label",
            "w": "hug",
            "text": "Read the guide",
            "size": 18,
            "weight": 600,
            "family": "text",
            "color": "#0b0f0b"
          }
        ]
      },
      {
        "kind": "frame",
        "id": "panel",
        "x": 616,
        "y": 144,
        "w": 440,
        "h": 352,
        "background": {
          "type": "solid",
          "color": "#0F1420"
        },
        "radius": 0,
        "border": {
          "width": 1,
          "color": "#1e2b1e"
        },
        "direction": "column",
        "gap": 18,
        "padding": {
          "top": 40,
          "right": 40,
          "bottom": 40,
          "left": 40
        },
        "children": [
          {
            "kind": "shape",
            "id": "chrome-dot",
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 12,
            "shape": "ellipse",
            "fill": {
              "type": "solid",
              "color": "#39ff88"
            }
          },
          {
            "kind": "text",
            "id": "line-1",
            "w": "fill",
            "text": "$ dsh plugin add canvas",
            "size": 15,
            "family": "mono",
            "color": "#9affc2"
          },
          {
            "kind": "text",
            "id": "line-2",
            "w": "fill",
            "text": "installed -> web profile",
            "size": 15,
            "family": "mono",
            "color": "#7fb68c"
          },
          {
            "kind": "text",
            "id": "line-3",
            "w": "fill",
            "text": "restart to compose",
            "size": 15,
            "family": "mono",
            "color": "#7fb68c"
          },
          {
            "kind": "text",
            "id": "line-4",
            "w": "fill",
            "text": "canvas_new { preset }",
            "size": 15,
            "family": "mono",
            "color": "#c9ffd6"
          }
        ]
      }
    ],
    "style": "terminal"
  }
}
