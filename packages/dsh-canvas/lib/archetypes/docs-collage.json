{
  "id": "docs-collage",
  "title": "Docs collage",
  "description": "Three overlapping panels with different radii and a soft shadow, like documents caught mid-flight, under a display headline - reaches for a documentation, changelog or knowledge-base cover.",
  "presets": [
    "github-social",
    "og",
    "linkedin-post"
  ],
  "document": {
    "title": "Docs collage",
    "preset": "github-social",
    "canvas": {
      "background": "surface"
    },
    "tokens": {
      "color": {
        "ink": "#F8FAFC",
        "muted": "#94A3B8",
        "accent": "#4D6BFE",
        "surface": "#0B0E14"
      },
      "font": {
        "display": "Space Grotesk",
        "text": "Inter",
        "mono": "system"
      },
      "scale": {
        "display": 84,
        "title": 40,
        "body": 22,
        "caption": 15
      },
      "space": 8,
      "radius": {
        "card": 20,
        "chip": 8,
        "pill": 999
      }
    },
    "layers": [
      {
        "kind": "shape",
        "id": "backdrop",
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 640,
        "shape": "rect",
        "fill": "surface"
      },
      {
        "kind": "text",
        "id": "headline",
        "x": 64,
        "y": 96,
        "w": 680,
        "text": "Everything on one canvas.",
        "style": "display",
        "family": "display",
        "weight": 700,
        "color": "ink"
      },
      {
        "kind": "shape",
        "id": "rule",
        "x": 64,
        "y": 232,
        "w": 72,
        "h": 4,
        "shape": "rect",
        "fill": "accent",
        "radius": 2
      },
      {
        "kind": "frame",
        "id": "panel-back",
        "x": 64,
        "y": 300,
        "w": 320,
        "h": 300,
        "rotate": -4,
        "radius": 32,
        "background": "#131A29",
        "border": {
          "width": 1,
          "color": "#94A3B833"
        },
        "shadow": {
          "x": 0,
          "y": 16,
          "blur": 40,
          "color": "#00000099"
        },
        "children": [
          {
            "kind": "text",
            "id": "back-title",
            "x": 32,
            "y": 40,
            "w": 240,
            "text": "Notes",
            "style": "body",
            "family": "display",
            "weight": 700,
            "color": "muted"
          },
          {
            "kind": "shape",
            "id": "back-rule",
            "x": 32,
            "y": 88,
            "w": 160,
            "h": 2,
            "shape": "rect",
            "fill": "#94A3B84D"
          }
        ]
      },
      {
        "kind": "frame",
        "id": "panel-mid",
        "x": 300,
        "y": 280,
        "w": 356,
        "h": 336,
        "radius": 12,
        "background": {
          "type": "linear",
          "angle": 160,
          "stops": [
            {
              "at": 0,
              "color": "#E2E8F0"
            },
            {
              "at": 1,
              "color": "#8FA2C4"
            }
          ]
        },
        "rotate": 3,
        "shadow": {
          "x": 0,
          "y": 18,
          "blur": 44,
          "color": "#000000A6"
        },
        "children": [
          {
            "kind": "text",
            "id": "mid-title",
            "x": 36,
            "y": 44,
            "w": 280,
            "text": "Runbook",
            "style": "body",
            "family": "display",
            "weight": 700,
            "color": "#0B0E14"
          },
          {
            "kind": "shape",
            "id": "mid-rule",
            "x": 36,
            "y": 96,
            "w": 200,
            "h": 2,
            "shape": "rect",
            "fill": "#0B0E1433"
          }
        ]
      },
      {
        "kind": "frame",
        "id": "panel-front",
        "x": 536,
        "y": 180,
        "w": 500,
        "h": 340,
        "radius": "card",
        "background": "surface",
        "border": {
          "width": 1,
          "color": "#94A3B840"
        },
        "shadow": {
          "x": 0,
          "y": 24,
          "blur": 56,
          "color": "#000000B3"
        },
        "children": [
          {
            "kind": "shape",
            "id": "front-chip",
            "x": 48,
            "y": 52,
            "w": 72,
            "h": 14,
            "shape": "rect",
            "fill": "accent",
            "radius": 7
          },
          {
            "kind": "text",
            "id": "front-title",
            "x": 48,
            "y": 108,
            "w": 404,
            "text": "The plugin guide",
            "style": "title",
            "family": "display",
            "weight": 700,
            "color": "ink"
          },
          {
            "kind": "shape",
            "id": "front-rule-1",
            "x": 48,
            "y": 200,
            "w": 340,
            "h": 2,
            "shape": "rect",
            "fill": "#94A3B84D"
          },
          {
            "kind": "shape",
            "id": "front-rule-2",
            "x": 48,
            "y": 228,
            "w": 300,
            "h": 2,
            "shape": "rect",
            "fill": "#94A3B84D"
          },
          {
            "kind": "shape",
            "id": "front-rule-3",
            "x": 48,
            "y": 256,
            "w": 300,
            "h": 2,
            "shape": "rect",
            "fill": "#94A3B84D"
          },
          {
            "kind": "text",
            "id": "front-caption",
            "x": 48,
            "y": 272,
            "w": 380,
            "text": "Twelve pages, no forks.",
            "style": "caption",
            "family": "text",
            "color": "muted"
          }
        ]
      }
    ]
  }
}
